# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# LLM Provider (choose one: ollama, openai, anthropic, google, xai)
LLM_PROVIDER=openai

# ─────────────────────────────────────────────
# Ollama (local, no auth needed)
# ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M

# ─────────────────────────────────────────────
# OpenAI (GPT-5)
# Auth: api_key (default) or oauth (Azure AD)
# ─────────────────────────────────────────────
OPENAI_AUTH_METHOD=api_key
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5

# For Azure OpenAI OAuth:
# OPENAI_AUTH_METHOD=oauth
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-5
# AZURE_OPENAI_API_VERSION=2024-02-01

# ─────────────────────────────────────────────
# Anthropic (Claude) - API key only
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ─────────────────────────────────────────────
# Google (Gemini)
# Auth: api_key (default) or oauth
# ─────────────────────────────────────────────
GOOGLE_AUTH_METHOD=api_key
GOOGLE_API_KEY=your-google-key
GOOGLE_MODEL=gemini-2.0-flash

# For Google OAuth:
# GOOGLE_AUTH_METHOD=oauth
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# Get credentials at: https://console.cloud.google.com/apis/credentials

# ─────────────────────────────────────────────
# xAI (Grok 4.2)
# Auth: api_key (default) or oauth (via X account)
# ─────────────────────────────────────────────
XAI_AUTH_METHOD=api_key
XAI_API_KEY=your-xai-key
XAI_MODEL=grok-4.2

# For xAI OAuth:
# XAI_AUTH_METHOD=oauth
# XAI_CLIENT_ID=your-client-id
# XAI_CLIENT_SECRET=your-client-secret
# Get credentials at: https://console.x.ai/api-keys

# ─────────────────────────────────────────────
# Evolution
# ─────────────────────────────────────────────
EVOLUTION_INTERVAL=5
LORA_OUTPUT_DIR=./models/lora
LOGS_DIR=./logs
